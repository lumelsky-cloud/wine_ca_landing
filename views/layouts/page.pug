doctype html
html(lang='ru')
  head
    meta(charset='utf-8')
    meta(name='viewport' content='width=device-width, initial-scale=1')
    meta(name='description' content='Moments — организация частных и корпоративных событий в Москве')
    title= title
    link(rel='stylesheet' href='/css/styles.css')
    link(rel='stylesheet' href='/css/gallery.css')
    link(rel='stylesheet' href='/css/event-detail.css')
    link(rel='stylesheet' href='/css/child-party.css')
    link(rel='stylesheet' href='/css/wine-casino.css')
    link(rel='stylesheet' href='/css/back-link.css')
    link(rel='stylesheet' href='/css/brand-logo.css')
    script(src='/js/main.js' defer)
  body
    if backToEvents
      a.event-back-link(href='/events') ← Вернуться к мероприятиям
    header.header
      a.brand(href='/' aria-label='Moments — на главную')
        img(src='/images/brand-logo.png' alt='Moments')
      button.menu-toggle(type='button' aria-label='Открыть меню' aria-expanded='false') Меню
      nav.nav(aria-label='Основная навигация')
        a(href='/#about') О нас
        a(href='/#services') Услуги
        a(href='/events') Форматы
        a(href='/#projects') Проекты
        a(href='/gifts') Подарки
        a(href='/partners') Партнёры
        a(href='/members') Членство
        a.nav__cta(href='#contact') Заказать мероприятие
    main
      block content
    include ../partials/footer.pug
    include ../partials/modal.pug
