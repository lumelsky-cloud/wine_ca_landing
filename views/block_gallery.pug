style.
  .cool-gallery {
    position: relative;
    overflow: hidden;
    padding: clamp(64px, 9vw, 112px) 0;
    color: #241719;
    background:
      radial-gradient(ellipse at 8% 12%, rgba(172, 20, 15, .18), transparent 30%),
      radial-gradient(ellipse at 94% 88%, rgba(244, 190, 174, .42), transparent 34%),
      linear-gradient(135deg, #fff8f0 0%, #f4e3da 52%, #fffaf4 100%);
    font-family: var(--kv-main, Manrope, Arial, sans-serif);
    isolation: isolate;
  }

  .cool-gallery__grain {
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: .12;
    background-image:
      linear-gradient(rgba(172, 20, 15, .11) 1px, transparent 1px),
      linear-gradient(90deg, rgba(36, 23, 25, .09) 1px, transparent 1px);
    background-size: 42px 42px;
    pointer-events: none;
  }

  .cool-gallery__watermark {
    position: absolute;
    top: 22px;
    left: 3%;
    z-index: 0;
    color: rgba(172, 20, 15, .09);
    font-size: clamp(4.2rem, 13vw, 12rem);
    font-weight: 900;
    line-height: .82;
    text-transform: uppercase;
    pointer-events: none;
  }

  .cool-gallery__container {
    position: relative;
    z-index: 1;
    width: min(calc(100% - 44px), 1120px);
    margin-inline: auto;
  }

  .cool-gallery__header {
    display: grid;
    grid-template-columns: minmax(150px, .24fr) minmax(0, .82fr) minmax(260px, .44fr);
    gap: clamp(18px, 3vw, 34px);
    align-items: end;
    margin-bottom: clamp(28px, 5vw, 54px);
  }

  .cool-gallery__label {
    display: flex;
    min-height: 140px;
    flex-direction: column;
    justify-content: space-between;
    padding: 20px;
    border: 1px solid rgba(172, 20, 15, .25);
    background: rgba(255, 250, 244, .62);
    backdrop-filter: blur(12px);
    font-size: .72rem;
    font-weight: 900;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .cool-gallery__label span {
    color: #AC140F;
    font-size: clamp(2.7rem, 5.6vw, 5rem);
    line-height: .82;
  }

  .cool-gallery__title {
    margin: 0;
    color: #241719;
    font-size: clamp(3rem, 7vw, 7rem);
    font-weight: 900;
    line-height: .82;
    text-transform: uppercase;
  }

  .cool-gallery__title span {
    color: #AC140F;
  }

  .cool-gallery__lead {
    margin: 0;
    padding-top: 22px;
    border-top: 1px solid rgba(172, 20, 15, .3);
    color: rgba(36, 23, 25, .74);
    font-size: .9rem;
    font-weight: 800;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .cool-gallery__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-rows: 158px;
    gap: 16px;
  }

  .cool-gallery__tile {
    position: relative;
    overflow: hidden;
    min-height: 0;
    border: 1px solid rgba(172, 20, 15, .22);
    background:
      linear-gradient(135deg, rgba(255, 255, 255, .7), rgba(255, 255, 255, .26)),
      rgba(255, 239, 231, .72);
    box-shadow: 0 22px 48px rgba(92, 24, 22, .13);
    transition: border-color .28s ease, box-shadow .28s ease, transform .28s ease;
  }

  .cool-gallery__tile::before {
    position: absolute;
    inset: 0;
    z-index: 1;
    content: "";
    background:
      linear-gradient(180deg, rgba(36, 23, 25, .12), transparent 42%, rgba(36, 23, 25, .56)),
      linear-gradient(135deg, rgba(255, 255, 255, .08), transparent 44%);
    pointer-events: none;
  }

  .cool-gallery__tile::after {
    position: absolute;
    right: -44px;
    bottom: -52px;
    width: 128px;
    height: 128px;
    content: "";
    border-radius: 50%;
    background: rgba(172, 20, 15, .28);
    pointer-events: none;
  }

  .cool-gallery__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(.98) contrast(1.03);
    transition:
      filter .28s ease,
      transform .32s ease;
  }

  .cool-gallery__tile:hover .cool-gallery__photo {
    filter: saturate(1.08) contrast(1.08);
    transform: scale(1.045);
  }

  .cool-gallery__tile:hover {
    border-color: #AC140F;
    box-shadow: 0 26px 56px rgba(92, 24, 22, .2);
    transform: translateY(-4px);
  }

  .cool-gallery__tile--large {
    grid-column: span 2;
    grid-row: span 2;
  }

  .cool-gallery__tile--wide {
    grid-column: span 2;
  }

  .cool-gallery__tile--blue {
    background:
      linear-gradient(135deg, rgba(255, 255, 255, .58), rgba(255, 255, 255, .18)),
      rgba(172, 20, 15, .28);
  }

  .cool-gallery__tile--dark {
    background: #241719;
    color: #fffaf4;
  }

  .cool-gallery__tile-number {
    position: absolute;
    left: 20px;
    top: 18px;
    z-index: 2;
    color: #fffaf4;
    font-size: .74rem;
    font-weight: 900;
    letter-spacing: .1em;
    line-height: 1;
    text-shadow: 0 2px 10px rgba(20, 34, 43, .42);
  }

  .cool-gallery__tile-line {
    position: absolute;
    left: 20px;
    right: 20px;
    bottom: 18px;
    z-index: 2;
    height: 1px;
    background: #fffaf4;
    opacity: .56;
  }

  .cool-gallery__tile-line::after {
    position: absolute;
    right: 0;
    top: -3px;
    width: 7px;
    height: 7px;
    content: "";
    border-radius: 50%;
    background: currentColor;
  }

  @media (max-width: 991.98px) {
    .cool-gallery__header {
      grid-template-columns: 1fr;
    }

    .cool-gallery__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: 150px;
    }
  }

  @media (max-width: 575.98px) {
    .cool-gallery {
      padding: 48px 0 64px;
    }

    .cool-gallery__container {
      width: min(calc(100% - 34px), 1120px);
    }

    .cool-gallery__title {
      font-size: clamp(2.6rem, 14vw, 4.3rem);
    }

    .cool-gallery__grid {
      grid-template-columns: 1fr;
      grid-auto-rows: 180px;
    }

    .cool-gallery__tile--large,
    .cool-gallery__tile--wide {
      grid-column: span 1;
      grid-row: span 1;
    }
  }
