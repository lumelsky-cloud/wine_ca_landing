.modal(aria-hidden='true')
  .modal__backdrop(data-close-modal)
  .modal__dialog(role='dialog' aria-modal='true' aria-labelledby='modal-title')
    button.modal__close(type='button' data-close-modal aria-label='Закрыть') ×
    p.eyebrow Свяжемся с вами
    h2#modal-title Обсудим ваш проект
    form.request-form(action='/request' method='post')
      label Имя
        input(type='text' name='name' required autocomplete='name')
      label Телефон
        input(type='tel' name='phone' required autocomplete='tel')
      label Задача
        textarea(name='message' rows='4')
      label.consent
        input(type='checkbox' required)
        span Согласен с политикой конфиденциальности
      button.button(type='submit') Отправить заявку
      p.form-status(role='status')
