footer.footer#contact
  unless hideFooterLead
    .footer__lead
      p.footer__eyebrow Давайте создадим событие вместе
      h2 Расскажите нам о вашей идее
      button.button.button--light(type='button' data-open-modal) Оставить заявку
  .footer__grid
    div
      a.footer__brand(href='/' aria-label='Moments — на главную')
        img(src='/images/brand-logo.png' alt='Moments')
      p Организаторы событий
    div
      p moments.moscow@gmail.com
      p Москва, ул. Дмитрия Ульянова, 31
    div
      a(href='https://wa.me/' rel='noopener') WhatsApp
      a(href='https://t.me/' rel='noopener') Telegram
    small Moments © 2026
