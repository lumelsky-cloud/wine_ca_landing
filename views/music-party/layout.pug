doctype html
html(lang='ru')
  head
    meta(charset='utf-8')
    meta(name='viewport' content='width=device-width, initial-scale=1')
    meta(name='description' content='Music Party — камерная музыкальная вечеринка от Moments')
    title Music Party — Moments
    link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css')
    link(rel='stylesheet' href='/css/music-party/styles.css')
    link(rel='stylesheet' href='/css/music-party/buttons.css')
  body.min-vh-100.d-flex.flex-column
    a.music-party-back(href='/events') ← Вернуться к мероприятиям
    main.flex-grow-1
      block content
    style.
      .music-party-back {
        position: fixed;
        top: 18px;
        left: 18px;
        z-index: 1000;
        padding: 10px 15px;
        color: #181818;
        background: rgba(255, 250, 244, .9);
        border: 1px solid rgba(24, 24, 24, .16);
        border-radius: 999px;
        font: 700 12px/1.2 Arial, sans-serif;
        text-decoration: none;
        backdrop-filter: blur(10px);
      }
